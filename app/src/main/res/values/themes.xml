<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TrayTimer" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/app_surface_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.TrayTimer.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/teal_900</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.TrayTimer</item>
    </style>

    <style name="Theme.TrayTimer.Alarm" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/teal_900</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>
</resources>
    <!-- OEM battery guides (DontKillMyApp-style, bundled) -->
    <string name="oem_title">Stop your phone from killing TrayTimer</string>
    <string name="oem_intro">Android manufacturers aggressively stop background apps. Follow the guide for your brand so reminders always fire.</string>
    <string name="oem_pixel">Stock Pixel / Motorola</string>
    <string name="oem_pixel_steps">Settings → Apps → TrayTimer → Battery → Unrestricted. Then Settings → Battery → Battery saver off for TrayTimer.</string>
    <string name="oem_samsung">Samsung</string>
    <string name="oem_samsung_steps">Settings → Apps → TrayTimer → Battery → Unrestricted. Also disable \"Put unused apps to sleep\": Settings → Battery → Background usage limits → remove TrayTimer from Sleeping apps and Deep sleeping apps.</string>
    <string name="oem_xiaomi">Xiaomi / Redmi / POCO</string>
    <string name="oem_xiaomi_steps">Security app → Speed booster → Lock TrayTimer in memory. Settings → Apps → Manage apps → TrayTimer → Autostart ON, Battery saver → No restrictions. Also enable Settings → Notifications → disable MIUI optimization for the app.</string>
    <string name="oem_huawei">Huawei / Honor</string>
    <string name="oem_huawei_steps">Settings → Battery → App launch → TrayTimer: disable Manage automatically, enable all three toggles. Also Protected apps → enable TrayTimer.</string>
    <string name="oem_oneplus">OnePlus / Oppo</string>
    <string name="oem_oneplus_steps">Settings → Battery → Battery optimization → All apps → TrayTimer → Don\'t optimize. Also Settings → Apps → TrayTimer → Battery usage → Allow background activity.</string>
    <string name="oem_vivo">Vivo / iQOO</string>
    <string name="oem_vivo_steps">Settings → Battery → Background power consumption management → allow TrayTimer. i Manager → App manager → Autostart for TrayTimer.</string>
    <string name="oem_asus">Asus</string>
    <string name="oem_asus_steps">Mobile Manager → Autostart manager → allow TrayTimer. Battery → PowerMaster → unrestrict TrayTimer.</string>
    <string name="oem_sony">Sony</string>
    <string name="oem_sony_steps">Settings → Battery → STAMINA → Apps active in standby → TrayTimer. Also disable App standby optimization for TrayTimer.</string>

